# Local development example. Process variables override this file.
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/intelliapply
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
NEON_AUTH_URL=https://YOUR_NEON_AUTH_HOST/neondb/auth
# Set from a verified JWT's issuer; required in production.
# NEON_AUTH_ISSUER=https://YOUR_ACTUAL_ISSUER
# Configure audience only if the actual issuer supplies that claim.
# NEON_AUTH_AUDIENCE=YOUR_ACTUAL_AUDIENCE
AUTO_CREATE_SCHEMA=false
SCHEDULER_ENABLED=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# Optional server-only secrets. Configure securely; never use VITE_ names.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# FIRECRAWL_API_KEY=
SCRAPER_SOURCES=hackernews
SCRAPER_MAX_JOBS_PER_SOURCE=15
SCRAPE_COOLDOWN_SECONDS=900
SCRAPER_SCHEDULE_HOURS=4
MATCHER_SCHEDULE_HOURS=6
JOB_POSTING_RETENTION_DAYS=30
MATCHER_MAX_JOBS=500
MAX_UPLOAD_BYTES=5242880
TASK_TIMEOUT_SECONDS=120
TASK_RETENTION_DAYS=7
REFRESH_COOLDOWN_SECONDS=60
RESUME_COOLDOWN_SECONDS=30
RESUME_GLOBAL_INTERVAL_SECONDS=10
PROVIDER_QUOTA_COOLDOWN_SECONDS=60
MAX_ACTIVE_TASKS=4
