# Public build variables. Never put database passwords/provider keys here.
# Local Vite API proxy:
VITE_API_BASE_URL=/
# Use the same project's public auth endpoint as the backend.
VITE_NEON_AUTH_URL=https://YOUR_NEON_AUTH_HOST/neondb/auth
# Production: use the actual HTTPS backend origin, without /api suffix.
# VITE_API_BASE_URL=https://YOUR_BACKEND_HOST
